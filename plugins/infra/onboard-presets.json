{
  "plugin": "infra",
  "description": "Risk-tiered allowlist + extra PreToolUse guard hooks for the infra plugin. Consumed by /onboard. balanced is the canonical read-only infra allowlist (it replaces the old /setup command). cautious narrows to local static validation + read-only cloud describe/get/list; permissive adds broader read-only probes. Hooks hard-block infra mutations per tier on top of the plugin floor.",
  "tiers": {
    "cautious": {
      "allow": [
        "Bash(terraform fmt -check*)",
        "Bash(terraform validate*)",
        "Bash(terraform show -json*)",
        "Bash(ansible-lint*)",
        "Bash(kubectl get*)",
        "Bash(kubectl describe*)",
        "Bash(kubectl kustomize*)",
        "Bash(helm lint*)",
        "Bash(helm list*)",
        "Bash(helm show*)",
        "Bash(docker compose config*)",
        "Bash(aws ec2 describe-*)",
        "Bash(aws iam get-*)",
        "Bash(aws iam list-*)",
        "Bash(aws s3api list-buckets*)",
        "Bash(gcloud projects get-iam-policy*)",
        "Bash(gcloud compute instances list*)",
        "Bash(gcloud container clusters describe*)",
        "Bash(gcloud container clusters list*)",
        "Bash(smartctl -a*)",
        "Bash(zpool status*)",
        "Bash(mdadm --detail*)"
      ],
      "hooks": [
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"terraform (apply|destroy)\" 2>/dev/null; then echo \"[onboard:cautious:terraform-mutate] terraform apply/destroy is blocked at the cautious tier. Review the plan, then ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"kubectl (apply|delete|patch|replace|scale|rollout|drain|cordon|uncordon)\" 2>/dev/null; then echo \"[onboard:cautious:kubectl-mutate] Mutating kubectl verbs are blocked at the cautious tier. Use get/describe/diff or ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"helm (install|upgrade|uninstall|rollback|delete)\" 2>/dev/null; then echo \"[onboard:cautious:helm-mutate] Mutating helm verbs are blocked at the cautious tier. Use lint/list/show/diff or ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"(aws|gcloud)[^|]* (create|put|update|delete|set-iam-policy|add-iam-policy-binding|remove-iam-policy-binding)\" 2>/dev/null; then echo \"[onboard:cautious:cloud-mutate] Mutating cloud CLI verbs (create/put/update/delete/iam) are blocked at the cautious tier. Use describe/get/list or ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"ansible-playbook\" 2>/dev/null && ! echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"[-][-]check\" 2>/dev/null; then echo \"[onboard:cautious:ansible-apply] ansible-playbook without --check is blocked at the cautious tier. Run --check --diff first, then ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        }
      ]
    },
    "balanced": {
      "allow": [
        "Bash(terraform fmt -check*)",
        "Bash(terraform validate*)",
        "Bash(terraform plan*)",
        "Bash(terraform show -json*)",
        "Bash(terraform plan -detailed-exitcode*)",
        "Bash(pulumi preview --diff*)",
        "Bash(ansible-lint*)",
        "Bash(ansible-inventory*)",
        "Bash(ansible-inventory --list*)",
        "Bash(ansible-playbook --check --diff*)",
        "Bash(kubectl get*)",
        "Bash(kubectl describe*)",
        "Bash(kubectl kustomize*)",
        "Bash(kubectl diff*)",
        "Bash(helm lint*)",
        "Bash(helm list*)",
        "Bash(helm show*)",
        "Bash(docker compose config*)",
        "Bash(python3 -c \"import yaml*)",
        "Bash(aws ec2 describe-*)",
        "Bash(aws iam get-*)",
        "Bash(aws iam list-*)",
        "Bash(aws iam generate-service-last-accessed-details*)",
        "Bash(aws iam get-service-last-accessed-details*)",
        "Bash(aws securityhub get-findings*)",
        "Bash(aws guardduty list-findings*)",
        "Bash(aws guardduty get-findings*)",
        "Bash(aws guardduty list-detectors*)",
        "Bash(aws inspector2 list-findings*)",
        "Bash(aws resourcegroupstaggingapi get-resources*)",
        "Bash(aws s3api list-buckets*)",
        "Bash(aws s3api get-bucket-tagging*)",
        "Bash(aws cloudformation detect-stack-drift*)",
        "Bash(aws cloudformation describe-stack-resource-drifts*)",
        "Bash(aws backup list-backup-plans*)",
        "Bash(aws backup list-backup-vaults*)",
        "Bash(aws elbv2 describe-load-balancers*)",
        "Bash(aws rds describe-db-instances*)",
        "Bash(aws rds describe-db-snapshots*)",
        "Bash(aws support describe-trusted-advisor-checks*)",
        "Bash(aws accessanalyzer list-findings*)",
        "Bash(gcloud projects get-iam-policy*)",
        "Bash(gcloud resource-manager folders get-iam-policy*)",
        "Bash(gcloud resource-manager organizations get-iam-policy*)",
        "Bash(gcloud compute instances list*)",
        "Bash(gcloud compute disks list*)",
        "Bash(gcloud compute addresses list*)",
        "Bash(gcloud recommender recommendations list*)",
        "Bash(gcloud container clusters describe*)",
        "Bash(gcloud container clusters list*)",
        "Bash(gcloud iam service-accounts list*)",
        "Bash(gcloud iam service-accounts keys list*)",
        "Bash(kubectl get clusterroles*)",
        "Bash(kubectl get roles*)",
        "Bash(kubectl get clusterrolebindings*)",
        "Bash(kubectl get rolebindings*)",
        "Bash(kubectl get serviceaccounts*)",
        "Bash(smartctl -a*)",
        "Bash(smartctl --all*)",
        "Bash(smartctl --json*)",
        "Bash(mdadm --detail*)",
        "Bash(zpool status*)",
        "Bash(zpool list*)",
        "Bash(ipmitool sel list*)",
        "Bash(ipmitool sensor list*)",
        "Bash(dmidecode*)"
      ],
      "hooks": [
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"terraform destroy\" 2>/dev/null; then echo \"[onboard:balanced:terraform-destroy] terraform destroy is blocked at the balanced tier. Ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"kubectl delete\" 2>/dev/null; then echo \"[onboard:balanced:kubectl-delete] kubectl delete is blocked at the balanced tier. Ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"helm uninstall|helm delete\" 2>/dev/null; then echo \"[onboard:balanced:helm-uninstall] helm uninstall/delete is blocked at the balanced tier. Ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        },
        {
          "type": "command",
          "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE \"(aws|gcloud)[^|]* delete\" 2>/dev/null; then echo \"[onboard:balanced:cloud-delete] Cloud CLI delete verbs are blocked at the balanced tier. Ask the user for explicit approval.\" && exit 2; fi'",
          "timeout": 5000
        }
      ]
    },
    "permissive": {
      "allow": [
        "Bash(terraform fmt -check*)",
        "Bash(terraform validate*)",
        "Bash(terraform plan*)",
        "Bash(terraform show*)",
        "Bash(terraform output*)",
        "Bash(terraform state list*)",
        "Bash(terraform providers*)",
        "Bash(pulumi preview*)",
        "Bash(ansible-lint*)",
        "Bash(ansible-inventory*)",
        "Bash(ansible-playbook --check --diff*)",
        "Bash(kubectl get*)",
        "Bash(kubectl describe*)",
        "Bash(kubectl kustomize*)",
        "Bash(kubectl diff*)",
        "Bash(kubectl logs*)",
        "Bash(kubectl top*)",
        "Bash(kubectl version*)",
        "Bash(kubectl api-resources*)",
        "Bash(helm lint*)",
        "Bash(helm list*)",
        "Bash(helm show*)",
        "Bash(helm history*)",
        "Bash(helm get*)",
        "Bash(docker compose config*)",
        "Bash(docker ps*)",
        "Bash(docker images*)",
        "Bash(python3 -c \"import yaml*)",
        "Bash(aws ec2 describe-*)",
        "Bash(aws sts get-caller-identity*)",
        "Bash(aws iam get-*)",
        "Bash(aws iam list-*)",
        "Bash(aws s3api list-buckets*)",
        "Bash(aws s3api get-bucket-*)",
        "Bash(aws cloudformation describe-*)",
        "Bash(aws rds describe-*)",
        "Bash(aws elbv2 describe-*)",
        "Bash(aws backup list-*)",
        "Bash(aws guardduty list-*)",
        "Bash(aws guardduty get-*)",
        "Bash(aws securityhub get-*)",
        "Bash(aws accessanalyzer list-*)",
        "Bash(aws resourcegroupstaggingapi get-resources*)",
        "Bash(gcloud config list*)",
        "Bash(gcloud projects get-iam-policy*)",
        "Bash(gcloud resource-manager folders get-iam-policy*)",
        "Bash(gcloud resource-manager organizations get-iam-policy*)",
        "Bash(gcloud compute instances list*)",
        "Bash(gcloud compute disks list*)",
        "Bash(gcloud compute addresses list*)",
        "Bash(gcloud recommender recommendations list*)",
        "Bash(gcloud container clusters describe*)",
        "Bash(gcloud container clusters list*)",
        "Bash(gcloud iam service-accounts list*)",
        "Bash(gcloud iam service-accounts keys list*)",
        "Bash(smartctl --all*)",
        "Bash(smartctl --json*)",
        "Bash(mdadm --detail*)",
        "Bash(zpool status*)",
        "Bash(zpool list*)",
        "Bash(ipmitool sel list*)",
        "Bash(ipmitool sensor list*)",
        "Bash(dmidecode*)"
      ],
      "hooks": []
    }
  }
}
